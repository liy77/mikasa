// Mikasa `json` — serde_json-backed helpers.
//
// Prefer native `json` values:
//   doc = json { "name": "Ana", "tags": ["a", "b"] }
//   doc["name"] / doc["tags"][0]
//   parse / stringify / at_* below
//
// String+path helpers remain for quick scraping of HTTP bodies.

// ── Value API ──────────────────────────────────────────────────────────────

func json parse(s: &str) {
    return serde_json::from_str::<JsonValue>(s).unwrap_or(JsonValue::Null)
}

func String stringify(v: &json) {
    return serde_json::to_string(v).unwrap_or_default()
}

func String stringify_pretty(v: &json) {
    return serde_json::to_string_pretty(v).unwrap_or_default()
}

func json object() {
    return json!({})
}

func json array() {
    return json!([])
}

func json null() {
    return JsonValue::Null
}

func json from_int(n: int) {
    return JsonValue::from(n)
}

func json from_float(n: f64) {
    return JsonValue::from(n)
}

func json from_bool(b: bool) {
    return JsonValue::from(b)
}

func json from_str(s: &str) {
    return JsonValue::String(s.to_string())
}

/// Dotted path on a value (`"user.name"`, `"tags.0"`). Missing → `Null`.
func json at(v: &json, path: &str) {
    if path.is_empty() {
        return v.clone()
    }
    mut ptr = format!("/{}", path.replace('.', "/"))
    return match v.pointer(&ptr) {
        Some(node) => node.clone(),
        None => JsonValue::Null,
    }
}

func String at_str(v: &json, path: &str) {
    return match at(v, path) {
        JsonValue::String(s) => s,
        JsonValue::Null => String::new(),
        other => other.to_string(),
    }
}

func i64 at_int(v: &json, path: &str) {
    return match at(v, path) {
        JsonValue::Number(n) => n.as_i64().or_else(|| n.as_f64().map(|f| f as i64)).unwrap_or(0),
        JsonValue::String(s) => s.trim().parse().unwrap_or(0),
        _ => 0,
    }
}

func f64 at_float(v: &json, path: &str) {
    return match at(v, path) {
        JsonValue::Number(n) => n.as_f64().unwrap_or(0.0),
        JsonValue::String(s) => s.trim().parse().unwrap_or(0.0),
        _ => 0.0,
    }
}

func bool at_bool(v: &json, path: &str) {
    return match at(v, path) {
        JsonValue::Bool(b) => b,
        JsonValue::String(s) => s.eq_ignore_ascii_case("true"),
        JsonValue::Number(n) => n.as_f64().map(|f| f != 0.0).unwrap_or(false),
        _ => false,
    }
}

func bool has_path(v: &json, path: &str) {
    if path.is_empty() {
        return !v.is_null()
    }
    mut ptr = format!("/{}", path.replace('.', "/"))
    return match v.pointer(&ptr) {
        Some(JsonValue::Null) => false,
        Some(_) => true,
        None => false,
    }
}

func i64 len_at(v: &json, path: &str) {
    return match at(v, path) {
        JsonValue::Array(a) => a.len() as i64,
        JsonValue::Object(o) => o.len() as i64,
        _ => 0,
    }
}

func Vec<String> keys_of(v: &json) {
    return match v {
        JsonValue::Object(o) => o.keys().cloned().collect(),
        _ => Vec::new(),
    }
}

func bool is_object(v: &json) {
    return v.is_object()
}

func bool is_array(v: &json) {
    return v.is_array()
}

func bool is_null(v: &json) {
    return v.is_null()
}

// ── String + path API ──────────────────────────────────────────────────────

func Option<String> locate(s: &str, path: &str) {
    mut root = serde_json::from_str::<JsonValue>(s).ok()?
    if path.is_empty() {
        return serde_json::to_string(&root).ok()
    }
    mut ptr = format!("/{}", path.replace('.', "/"))
    mut node = root.pointer(&ptr)?
    return serde_json::to_string(node).ok()
}

func bool is_valid(s: &str) {
    return serde_json::from_str::<JsonValue>(s).is_ok()
}

func String get(s: &str, path: &str) {
    return at_str(&parse(s), path)
}

func i64 get_int(s: &str, path: &str) {
    return at_int(&parse(s), path)
}

func f64 get_float(s: &str, path: &str) {
    return at_float(&parse(s), path)
}

func bool get_bool(s: &str, path: &str) {
    return at_bool(&parse(s), path)
}

func bool has(s: &str, path: &str) {
    return has_path(&parse(s), path)
}

func i64 len(s: &str, path: &str) {
    return len_at(&parse(s), path)
}

func String pretty(s: &str) {
    if !is_valid(s) {
        return String::new()
    }
    return stringify_pretty(&parse(s))
}

func String minify(s: &str) {
    if !is_valid(s) {
        return String::new()
    }
    return stringify(&parse(s))
}

func Vec<String> keys(s: &str, path: &str) {
    return keys_of(&at(&parse(s), path))
}
