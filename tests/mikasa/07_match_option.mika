import("harness.mika")

func describe(n: int) -> int {
    return match n {
        0 => 0,
        1 | 2 => 1,
        _ => 9,
    }
}

func main() {
    check_eq("match 0", describe(0), 0)
    check_eq("match or", describe(2), 1)
    check_eq("match default", describe(5), 9)

    mut o = Some(7)
    mut got = 0
    match o {
        Some(v) => { got = v },
        None => { got = -1 },
    }
    check_eq("option some", got, 7)

    mut n: Option<int> = None
    mut got2 = 0
    match n {
        Some(v) => { got2 = v },
        None => { got2 = -1 },
    }
    check_eq("option none", got2, -1)

    mut r: Result<int, string> = Ok(3)
    mut got3 = 0
    match r {
        Ok(v) => { got3 = v },
        Err(_) => { got3 = -1 },
    }
    check_eq("result ok", got3, 3)
    summary()
}
