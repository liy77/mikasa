{
  "name": "mikasa-lsp",
  "displayName": "Mikasa",
  "description": "Language support for Mikasa (.mika, .crs) — syntax highlight, diagnostics, completion, document symbols, hover. Mikasa was formerly Copper.",
  "version": "0.0.1",
  "publisher": "copper-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/liy77/mikasa"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "icon": "icons/mikasa-lsp.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:copper",
    "onLanguage:kson"
  ],
  "contributes": {
    "languages": [
      {
        "id": "copper",
        "aliases": ["Mikasa", "Copper", "copper"],
        "extensions": [".mika", ".crs"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mika-icon-light.png",
          "dark": "./icons/mika-icon-dark.png"
        }
      },
      {
        "id": "kson",
        "aliases": ["KSON", "kson"],
        "extensions": [".kson"],
        "configuration": "./kson-language-configuration.json",
        "icon": {
          "light": "./icons/kson-icon.svg",
          "dark": "./icons/kson-icon.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "copper.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Mikasa"
      },
      {
        "command": "mikasa.runFile",
        "title": "Run Current File",
        "category": "Mikasa"
      },
      {
        "command": "mikasa.debugFile",
        "title": "Debug Current File",
        "category": "Mikasa"
      }
    ],
    "snippets": [
      {
        "language": "copper",
        "path": "./snippets/mikasa.code-snippets"
      }
    ],
    "debuggers": [
      {
        "type": "mikasa",
        "label": "Mikasa",
        "languages": ["copper"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .mika file to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the program.",
                "items": { "type": "string" },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break on the first line.",
                "default": false
              },
              "runtime": {
                "type": "string",
                "enum": ["astra", "mikasa"],
                "description": "astra interprets instantly; mikasa transpiles to Rust and runs the binary.",
                "default": "astra"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Mikasa: run the current file",
            "description": "Interpret the open .mika with Astra and break on the first line.",
            "body": {
              "name": "Run ${fileBasename}",
              "type": "mikasa",
              "request": "launch",
              "program": "${file}",
              "runtime": "astra",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "breakpoints": [
      { "language": "copper" }
    ],
    "grammars": [
      {
        "language": "copper",
        "scopeName": "source.copper",
        "path": "./syntaxes/copper.tmLanguage.json"
      },
      {
        "language": "kson",
        "scopeName": "source.kson",
        "path": "./syntaxes/kson.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Mikasa",
      "properties": {
        "copper.serverPath": {
          "type": "string",
          "default": "copper-lsp",
          "description": "Path to the copper-lsp executable. Defaults to PATH lookup."
        },
        "copper.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the LSP communication."
        },
        "mikasa.runtime": {
          "type": "string",
          "enum": ["astra", "mikasa"],
          "default": "astra",
          "description": "How Run and the debugger execute a .mika: astra interprets it, mikasa transpiles it to Rust."
        },
        "mikasa.mikasaPath": {
          "type": "string",
          "default": "mikasa",
          "description": "Path to the mikasa transpiler, used when mikasa.runtime is mikasa."
        },
        "mikasa.astraPath": {
          "type": "string",
          "default": "alloy",
          "description": "Path to the Astra interpreter (binary name alloy)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
