// `net` — TCP/UDP over the standard library.
import { resolve, is_port_open, tcp_request, local_ip } from net

cf = resolve("one.one.one.one:80")
ip = local_ip()
println!("cloudflare = ${cf}")
println!("my ip      = ${ip}")

req = "GET / HTTP/1.0\r\nHost: example.com\r\nConnection: close\r\n\r\n"
resp = tcp_request("example.com:80", req)
println!("got ${resp.len()} bytes from example.com")

open80 = is_port_open("example.com", 80)
println!("port 80 open: ${open80}")
