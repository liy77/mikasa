import { encode, decode, query2, join } from url

enc = encode("hello world & co")
dec = decode("hello%20world%20%26%20co")
q = query2("q", "café", "page", "2")
j = join("https://api.example.com/", "/search")
println!("encode: ${enc}")
println!("decode: ${dec}")
println!("query:  ${q}")
println!("join:   ${j}")
