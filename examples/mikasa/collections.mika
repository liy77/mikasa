// Vec literals and Mikasa collection helpers (`.map` / `.filter`).
// Interpolation uses Display when possible, Debug otherwise — no `{:?}` in source.

mut nums = [1, 2, 3, 4, 5]
mut first = nums[0]
println!("first = $first")

mut doubled = nums.map(|x| x * 2)
println!("doubled = ${doubled}")

mut threshold = 3
mut big = nums.filter(|x| x > threshold)
println!("big = ${big}")

mut value = "42".parse::<i32>().unwrap()
println!("parsed = $value")
