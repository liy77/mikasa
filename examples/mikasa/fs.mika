// `fs` — filesystem operations.
import { mkdir, write, read, append, exists, size, list, remove_dir } from fs

dir = "/tmp/mikasa_fs_demo"
file = "/tmp/mikasa_fs_demo/note.txt"
mkdir(dir)
write(file, "line 1\n")
append(file, "line 2\n")
ex = exists(file)
sz = size(file)
body = read(file)
entries = list(dir)
println!("exists = ${ex}")
println!("size   = ${sz}")
println!("body   =\n${body}")
println!("list   =\n${entries}")
remove_dir(dir)
