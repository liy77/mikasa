// `crypto` — hashing + encoding.
import { base64_encode, base64_decode, hex_encode, sha256, hmac_sha256, crc32 } from crypto

b64 = base64_encode("hello mikasa")
b64dec = base64_decode("aGVsbG8gY29wcGVy")
hx = hex_encode("abc")
sha = sha256("abc")
mac = hmac_sha256("secret", "payload")
crc = crc32("123456789")
println!("b64    = ${b64}")
println!("b64dec = ${b64dec}")
println!("hex    = ${hx}")
println!("sha256 = ${sha}")
println!("hmac   = ${mac}")
println!("crc32  = ${crc}")
