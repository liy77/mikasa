// Async without naming the runtime. `async func`, `.await`, `sleep`,
// `spawn`, `timeout`, and `join!` pull it in and wrap main.

async func int tick(n: int) {
    sleep(n)
    return n
}

async func string greet(name: string) {
    sleep(5)
    return "hello, ${name}"
}

async func main() {
    println!("-- sleep / spawn --")
    sleep(20)

    h = spawn({
        sleep(10)
        println!("spawned task done")
    })
    h.await.unwrap()

    println!("-- join! --")
    (a, b) = join!(tick(5), tick(8))
    println!("joined = ${a} + ${b}")

    println!("-- timeout --")
    ok = timeout(100, tick(1))
    slow = timeout(5, tick(50))
    match ok {
        Ok(n) => println!("fast  = ${n}"),
        Err(_) => println!("fast  = timed out"),
    }
    match slow {
        Ok(n) => println!("slow  = ${n}"),
        Err(_) => println!("slow  = timed out"),
    }

    msg = greet("mikasa").await
    println!("greet = ${msg}")
}
