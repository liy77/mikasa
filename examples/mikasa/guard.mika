// `guard`: the happy path falls through, the `else` must leave the scope,
// and a `guard let` binding stays usable afterwards.

func int labeled() {
    mut n = 0
    'outer: loop {
        n = n + 1
        guard n < 3 else {
            break 'outer
        }
    }
    return n
}

func int first_positive(xs: Vec<i64>) {
    guard !xs.is_empty() else {
        return -1
    }
    guard let Some(n) = xs.first().copied() else {
        return -1
    }
    guard n > 0 else {
        return 0
    }
    return n
}

func int clamp_or_skip(n: int) {
    guard n >= 0 else {
        println!("negative, skipping")
        return -1
    }
    return n
}

empty = vec![]
neg = vec![-3]
pos = vec![4, 5]
println!("first_positive([]) = ${first_positive(empty)}")
println!("first_positive([-3]) = ${first_positive(neg)}")
println!("first_positive([4, 5]) = ${first_positive(pos)}")
println!("clamp_or_skip(-2) = ${clamp_or_skip(-2)}")
println!("clamp_or_skip(9) = ${clamp_or_skip(9)}")
println!("labeled() = ${labeled()}")
