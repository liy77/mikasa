// `http` — HTTP/HTTPS client. Requests return a rich Response.
import { get, post_json, download } from http

r = get("https://example.com")
println!("status = ${r.status}")
println!("body   = ${r.body.len()} bytes")
println!("ok     = ${r.is_ok()}")

reply = post_json("https://httpbin.org/post", "{\"hello\":\"mikasa\"}")
println!("post status = ${reply.status}")
body = reply.json()
println!("post echo   = ${body[\"json\"][\"hello\"]}")

saved = download("https://example.com", "example.html")
println!("downloaded = ${saved}")
