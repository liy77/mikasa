// Impl methods: optional / generic returns, generic params, and `self`.
// A bare `self` borrows, so a value can be inspected by many methods.

struct Rect {
    w: f64
    h: f64
}

impl Rect {
    func Rect new(w: f64, h: f64) {
        return Rect { w, h }
    }

    func f64 area(self) {
        return self.w * self.h
    }

    func f64? aspect(self) {
        if self.h == 0.0 {
            return None
        }
        return Some(self.w * self.h.recip())
    }

    func Option<Rect> scaled(self, k: f64) {
        if k == 0.0 {
            return None
        }
        return Some(Rect::new(self.w * k, self.h * k))
    }

    func f64 weighted(self, ks: Vec<f64>) {
        mut total = 0.0
        for k in ks {
            total += k
        }
        return self.area() * total
    }
}

mut b = Rect::new(4.0, 2.0)
println!("area = ${b.area()}")
match b.aspect() {
    Some(a) => println!("aspect = ${a}"),
    None => println!("aspect = none"),
}
match b.scaled(3.0) {
    Some(r) => println!("scaled area = ${r.area()}"),
    None => println!("scaled area = none"),
}
println!("weighted = ${b.weighted(vec![0.5, 1.0, 2.0])}")
