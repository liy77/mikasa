// Loop forms:
//   loop  { … }          — infinite, exit with `break`
//   while cond { … }     — pre-tested
//   for x in iter { … }  — iterator-driven

mut count = 0
loop {
    count++
    if count == 3 {
        break
    }
}

mut n = 5
while n > 0 {
    n--
    if n == 2 {
        continue
    }
}

for i in 0..5 {
    println!("i = ${i}")
}
