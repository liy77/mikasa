// Optional chaining: `?.` safely accesses fields/methods on Option values.
// Each `obj?.x` returns an Option — missing values short-circuit, no panic.

struct User {
    name: string
    age: int
}

mut user: Option<User> = Some(User {
    name: "Brian",
    age: 30,
})

mut age = user?.age
match age {
    Some(a) => println!("age = ${a}"),
    None => println!("age = none"),
}

mut name_len = user?.name.len()
match name_len {
    Some(n) => println!("name_len = ${n}"),
    None => println!("name_len = none"),
}

mut missing: Option<User> = None
mut missing_age = missing?.age
match missing_age {
    Some(a) => println!("missing_age = ${a}"),
    None => println!("missing_age = none"),
}

mut greeting_len = user?.name.chars().count()
match greeting_len {
    Some(n) => println!("greeting_len = ${n}"),
    None => println!("greeting_len = none"),
}
