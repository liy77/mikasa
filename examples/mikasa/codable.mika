// `codable` types: declare once, then encode/decode JSON.
//
//   u.to_json() / u.to_json_pretty()
//   User::from_json(text)
//   encode(&u) / decode(User, text)
//   JSONEncoder::pretty() / JSONDecoder::new()

codable struct User {
    name: string
    age: int
}

codable struct Team {
    title: string
    members: Vec<User>
}

u = User { name: "Ada", age: 36 }

println!("to_json = ${u.to_json()}")
pretty = u.to_json_pretty()
println!("pretty =\n${pretty}")

back = User::from_json(&pretty).unwrap()
println!("from_json = ${back.name} / ${back.age}")

js = encode(&u)
again = decode(User, js).unwrap()
println!("decode = ${again.name} / ${again.age}")

enc = JSONEncoder::pretty()
dec = JSONDecoder::new()
team = Team {
    title: "Pioneers",
    members: [
        User { name: "Ada", age: 36 },
        User { name: "Grace", age: 40 },
    ],
}
tjs = enc.encode(&team)
loaded = dec.decode::<Team>(&tjs).unwrap()
println!("team ${loaded.title} has ${loaded.members.len()} members")
println!("${loaded.to_json_pretty()}")
