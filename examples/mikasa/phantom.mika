// Phantom markers — unused type parameters stay intentional.
//
// Inside a struct/class body:
//   phantom T
//   phantom T, U
// Literals do not need PhantomData — mikasa fills `_phantom_*` for you.
// If you forget the mark, `mikasa run` warns before compiling.

struct Token<T> {
    phantom T
    id: int
}

struct Dual<A, B> {
    phantom A, B
    tag: string
}

func void main() {
    t = Token::<i64> { id: 1 }
    d = Dual::<bool, String> { tag: "ok" }
    println!("token ${t.id} dual ${d.tag}")
}
