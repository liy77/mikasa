import { input, sleep_ms, now_ms, args, env, exists } from cstd

name = input("What is your name? ")
println!("Hello, ${name}!")

started = now_ms()
sleep_ms(50)
elapsed = now_ms() - started
println!("Slept ~${elapsed}ms")

path = env("PATH")
toml_ok = exists("Cargo.toml")
extra = args()
println!("PATH has ${path.len()} chars")
println!("Cargo.toml exists? ${toml_ok}")
println!("extra args: ${extra}")

if name.is_empty() {
    println!("(no name given)")
}
