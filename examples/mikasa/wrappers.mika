// Property wrappers: `@Wrapper field` stores a wrapper instead of the
// annotated type. Read/write through `.wrappedValue`.

@propertyWrapper
struct Clamped {
    wrappedValue: int
    min: int
    max: int
}

impl Clamped {
    func Clamped new(v: int, min: int, max: int) {
        mut x = v
        if x < min {
            x = min
        }
        if x > max {
            x = max
        }
        return Clamped { wrappedValue: x, min: min, max: max }
    }
}

@propertyWrapper
struct NonEmpty {
    wrappedValue: string
}

impl NonEmpty {
    func NonEmpty new(s: string) {
        if s.is_empty() {
            return NonEmpty { wrappedValue: "(empty)" }
        }
        return NonEmpty { wrappedValue: s }
    }
}

struct Form {
    @Clamped age: int
    @NonEmpty name: string
}

mut f = Form {
    age: Clamped::new(150, 0, 120),
    name: NonEmpty::new(""),
}
println!("clamped age = ${f.age.wrappedValue} (was 150, max 120)")
println!("nonempty name = ${f.name.wrappedValue}")

f.age = Clamped::new(25, 0, 120)
f.name = NonEmpty::new("Ada")
println!("age = ${f.age.wrappedValue}  name = ${f.name.wrappedValue}")
