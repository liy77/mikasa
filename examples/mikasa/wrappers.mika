// Property wrappers: `@Wrapper field` stores a wrapper value instead of the
// annotated type. Read/write through `.wrappedValue`.

@propertyWrapper
struct Clamped {
    wrappedValue: int
    min: int
    max: int
}

impl Clamped {
    func Clamped new(v: int, min: int, max: int) {
        mut x = v
        if x < min {
            x = min
        }
        if x > max {
            x = max
        }
        return Clamped { wrappedValue: x, min: min, max: max }
    }
}

@propertyWrapper
struct NonEmpty {
    wrappedValue: string
}

impl NonEmpty {
    func NonEmpty new(s: string) {
        if s.is_empty() {
            return NonEmpty { wrappedValue: "(empty)".to_string() }
        }
        return NonEmpty { wrappedValue: s }
    }
}

struct Form {
    @Clamped age: int
    @NonEmpty name: string
}

mut f = Form {
    age: Clamped::new(150, 0, 120),
    name: NonEmpty::new("".to_string()),
}
println!("clamped age = {} (was 150, max 120)", f.age.wrappedValue)
println!("nonempty name = {}", f.name.wrappedValue)

f.age = Clamped::new(25, 0, 120)
f.name = NonEmpty::new("Ada".to_string())
println!("age = {}  name = {}", f.age.wrappedValue, f.name.wrappedValue)
