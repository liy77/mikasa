// String interpolation.
//
//   $name        — bare identifier
//   ${expr}      — full expression, brace-balanced
//
// Inside `println!("…")` interpolations expand into the format string.
// In assignments they produce a string.

mut name = "Brian"
mut count = 3

println!("Hello $name!")
println!("You have $count messages, doubled = ${count * 2}")

mut greeting = "Hi $name, welcome back."
println!("${greeting}")

for i in 0..3 {
    println!("Iteration ${i + 1} of $count")
}

class Greeting {
    name: string
    Greeting(name: string) {
        self.name = name
    }
}
