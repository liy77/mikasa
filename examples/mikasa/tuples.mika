// Tuples: create, index, destructure, and return.

point = (3, 7)
println!("x=${point.0} y=${point.1}")

(a, b) = (10, 20)
println!("a=${a} b=${b}")

mut (x, y) = (100, 200)
x = x + y
println!("x+y=${x}")

(mut p, q) = (5, 6)
p = p * 2
println!("p*2=${p} q=${q}")

func (int, int) minmax(a: int, b: int) {
    if a < b {
        return (a, b)
    }
    return (b, a)
}

(lo, hi) = minmax(9, 3)
println!("lo=${lo} hi=${hi}")

nested = ((1, 2), (3, 4))
println!("inner0.0=${nested.0.0}")
println!("inner1.1=${nested.1.1}")

((a, b), (c, d)) = nested
println!("a=${a} b=${b} c=${c} d=${d}")
