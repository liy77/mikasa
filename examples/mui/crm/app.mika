// app.mika — Mikasa + MocidaUI in one file.
//
// A `.mika` that declares a `view` is a MocidaUI document, so logic and UI
// share one extension. Real Mikasa declarations (struct / impl / func) live
// alongside the `view`s that describe the UI.

struct Todo {
  title: string
  done: bool
}

impl Todo {
  func string label(self) {
    return self.title
  }
}

func int add(a: int, b: int) {
  return a + b
}

view App(title: string = "Todos") {
  mut items = signal([])

  Stack(orientation: vertical, gap: 12, padding: 24) {
    Text("${title}", size: 28, color: #0f172a, fontStyle: FontStyle.Bold)

    for item in items {
      Text("${item}", size: 16, color: #334155)
    }

    TextField(value: "", placeholder: "Add a todo", onChange: { |v| items = v })
    Button("Add", onClick: { items.push("item") })
  }
}
