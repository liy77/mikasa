// Astra — declarative GUI, written entirely in Mikasa. Rendered by the native
// host in `astra-gui` (src/main.rs), which links `backend.mika` and drives the
// signals below.
//
// Dark chrome with the dove's red (#e23b3b) as the single accent. Built on
// the newer mocida chrome: NavBar for the top bar, SegmentedControl for the
// editor mode, Glass cards for the panels, Switch for the live options.
//
// Signals driven by the host:
//   version        (str)  set at startup with the binary version
//   source         (str)  the .crs code in the editor / runner
//   output         (str)  captured output of the last run
//   run_trigger    (int)  the host observes the change and runs `source`
//   open_path      (str)  path to open; host reads the file → source
//   update_trigger (int)  host observes → checks/applies update
//   update_status  (str)  result of the update

App() {
  name: "Astra"
  width: 1080
  height: 720
  minWidth: 760
  minHeight: 520
  background: #0c0c0f
  mainContent: AstraApp
  host: "astra-gui"
}

view AstraApp() {
  mut nav            = signal(0)             // 0 playground, 1 runner, 2 updates
  mut mode           = signal(0)             // 0 split, 1 editor, 2 output
  mut source         = signal("")
  mut output         = signal("")
  mut run_trigger    = signal(0)
  mut open_path      = signal("")
  mut open_trigger   = signal(0)
  mut path_field     = signal("")
  mut update_trigger = signal(0)
  mut update_status  = signal("")
  mut version        = signal("...")
  mut wrap_output    = signal(true)
  mut status         = signal("")

  Stack(orientation: vertical, align: stretch, background: #0c0c0f) {

    // A hand-rolled bar rather than NavBar: mocida's UINavBar_Destroy
    // double-frees on the resize rebuild (signal 10), which fires on the
    // first tick. SegmentedControl gives the same navigation without it.
    Rectangle(width: Window.width, height: 60, background: #111114,
      borderColor: #23232a, borderWidth: 1) {
      Stack(orientation: horizontal, align: center, justify: spaceBetween,
        paddingLeft: 16, paddingRight: 16, width: Window.width, height: 60) {
        Stack(orientation: horizontal, align: center, gap: 12, height: 44) {
          Image("icon.png", width: 40, height: 40, fillMode: fit,
            antialiasing: true)
          Stack(orientation: vertical, gap: 1, align: left, justify: center) {
            Text("Astra", size: 18, color: #f4f4f5, weight: bold)
            Text("interprets Mikasa", size: 10, color: #6e6e78)
          }
        }
        Stack(orientation: horizontal, align: center, gap: 6) {
          NavButton("Playground", nav == 0, 0, nav, "code.png")
          NavButton("Runner", nav == 1, 1, nav, "terminal.png")
          NavButton("Updates", nav == 2, 2, nav, "update.png")
        }
      }
    }

    if nav == 0 {
      Playground(mode, source, output, run_trigger, wrap_output, status)
    } else if nav == 1 {
      Runner(path_field, output, run_trigger, open_trigger, wrap_output, status)
    } else {
      Updates(version, update_status, update_trigger)
    }
  }
}

// Editor + output. `mode` picks the arrangement: 0 side by side, 1 editor
// only, 2 output only. The wide threshold keeps the split usable.
view Playground(mode, source, output, run_trigger, wrap_output, status) {
  Stack(orientation: vertical, align: stretch, gap: 12, padding: 16,
    width: Window.width, height: Window.height - 60) {

    Stack(orientation: horizontal, align: center, justify: spaceBetween,
      width: Window.width - 36, height: 40) {
      Stack(orientation: horizontal, align: center, gap: 10) {
        Text("MIKASA", size: 11, color: #e23b3b, weight: bold)
        Text("playground", size: 13, color: #8d8d95)
        if status != "" {
          Text(status, size: 12, color: #6e6e78)
        }
      }
      Stack(orientation: horizontal, align: center, gap: 12) {
        Stack(orientation: horizontal, align: center, gap: 4) {
          NavButton("Split", mode == 0, 0, mode, "split.png")
          NavButton("Editor", mode == 1, 1, mode, "code.png")
          NavButton("Output", mode == 2, 2, mode, "terminal.png")
        }
        Stack(orientation: horizontal, align: center, gap: 7, height: 34,
          background: #e23b3b, radius: 9, paddingLeft: 14, paddingRight: 16,
          cursor: pointer,
          onClick: { status = "running…"; run_trigger = run_trigger + 1 }) {
          Image("play.png", width: 15, height: 15, fillMode: fit)
          Text("Run", size: 14, color: #ffffff, weight: bold)
        }
      }
    }

    if mode == 1 {
      EditorPane(source, Window.width - 32, Window.height - 140)
    } else if mode == 2 {
      OutputPane(output, wrap_output, Window.width - 32, Window.height - 140)
    } else if Window.width == 0 or Window.width >= 980 {
      Stack(orientation: horizontal, align: stretch, gap: 14,
        width: Window.width - 32, height: Window.height - 140) {
        EditorPane(source, (Window.width - 46) / 2, Window.height - 140)
        OutputPane(output, wrap_output, (Window.width - 46) / 2, Window.height - 140)
      }
    } else {
      Stack(orientation: vertical, align: stretch, gap: 14,
        width: Window.width - 36) {
        EditorPane(source, Window.width - 36, (Window.height - 190) / 2)
        OutputPane(output, wrap_output, Window.width - 36, (Window.height - 190) / 2)
      }
    }
  }
}

// One pill of the navigation. `on` is the active state, `index` the value it
// writes into `target`. Buttons, not SegmentedControl: mocida double-frees
// that widget when the tree rebuilds on resize.
// A nav pill with its icon. The icon sits beside the label because mocida's
// Button paints text only; the glyph comes from the platform set (Material
// Symbols on Windows and Linux, the same outlined weight on macOS, where
// SF Symbols are not loadable from outside an Apple-signed bundle).
view NavButton(label, on, index, target, icon) {
  if on {
    Stack(orientation: horizontal, align: center, gap: 6, height: 32,
      background: #e23b3b, radius: 8, paddingLeft: 10, paddingRight: 12,
      cursor: pointer, onClick: { target = index }) {
      Image(icon, width: 15, height: 15, fillMode: fit)
      Text(label, size: 13, color: #ffffff)
    }
  } else {
    Stack(orientation: horizontal, align: center, gap: 6, height: 32,
      background: #1a1a1f, radius: 8, paddingLeft: 10, paddingRight: 12,
      cursor: pointer, onClick: { target = index }) {
      Image(icon, width: 15, height: 15, fillMode: fit)
      Text(label, size: 13, color: #8d8d95)
    }
  }
}

view EditorPane(source, w, h) {
  Stack(orientation: vertical, align: stretch, gap: 8, width: w, height: h) {
    Stack(orientation: horizontal, align: center, gap: 8, width: w, height: 18) {
      Text("SOURCE", size: 11, color: #8d8d95, weight: bold)
      Text(".mika", size: 11, color: #5c5c66)
    }
    TextArea(
      value: source,
      placeholder: "func main() {\n    println(\"hello from Astra\")\n}",
      width: w,
      height: h - 26,
      background: #10141c,
      textColor: #d6e2f0,
      borderColor: #2a2a32,
      borderWidth: 1,
      radius: 12,
      padding: 16,
      fontSize: 14,
      cursor: text,
      onChange: { |v| source = v },
    )
  }
}

view OutputPane(output, wrap_output, w, h) {
  Stack(orientation: vertical, align: stretch, gap: 8, width: w, height: h) {
    Stack(orientation: horizontal, align: center, justify: spaceBetween,
      width: w, height: 24) {
      Text("OUTPUT", size: 11, color: #8d8d95, weight: bold)
      Switch("wrap", value: wrap_output, onColor: #e23b3b, offColor: #2a2a32,
        knobColor: #ffffff, labelColor: #8d8d95, labelSize: 11,
        onChange: { |v| wrap_output = v })
    }
    Rectangle(width: w, height: h - 32, background: #0c1210, radius: 12,
      borderColor: #1e3a2e, borderWidth: 1) {
      Text(output, size: 13, color: #b6e3c4, align: left, vAlign: top, padding: 16,
        wrap: wrap_output)
    }
  }
}

// Run a .crs straight from disk. The path field wins over the editor when it
// points at a real file — the host checks that before running.
view Runner(path_field, output, run_trigger, open_trigger, wrap_output, status) {
  Stack(orientation: vertical, align: stretch, gap: 14, padding: 18,
    width: Window.width, height: Window.height - 58) {

    Glass(effect: liquid, radius: 16, padding: 16, tint: #16161b, tintOpacity: 0.92,
      width: Window.width - 36) {
      Stack(orientation: vertical, align: stretch, gap: 12, width: Window.width - 68) {
        Text("OPEN A FILE", size: 11, color: #e23b3b, weight: bold)
        Text("Point Astra at a .mika on disk. It runs that file instead of the editor.",
          size: 13, color: #8d8d95, wrap: true, width: Window.width - 68)
        Input(
          value: path_field,
          placeholder: "path/to/file.mika",
          width: Window.width - 68,
          height: 40,
          background: #0e0e12,
          textColor: #f4f4f5,
          placeholderColor: #5c5c66,
          borderColor: #2a2a32,
          borderColorFocused: #e23b3b,
          borderWidth: 1,
          radius: 10,
          padding: 12,
          fontSize: 14,
          cursor: text,
          onChange: { |v| path_field = v },
        )
        Stack(orientation: horizontal, gap: 10, align: center) {
          Stack(orientation: horizontal, align: center, gap: 7, height: 36,
            background: #1e1e24, radius: 9, paddingLeft: 12, paddingRight: 14,
            borderColor: #2e2e36, borderWidth: 1, cursor: pointer,
            onClick: { open_trigger = open_trigger + 1 }) {
            Image("folder.png", width: 15, height: 15, fillMode: fit)
            Text("Choose file", size: 13, color: #d6d6dc)
          }
          Stack(orientation: horizontal, align: center, gap: 7, height: 36,
            background: #e23b3b, radius: 9, paddingLeft: 12, paddingRight: 14,
            cursor: pointer,
            onClick: { status = "running…"; run_trigger = run_trigger + 1 }) {
            Image("play.png", width: 15, height: 15, fillMode: fit)
            Text("Run file", size: 13, color: #ffffff, weight: bold)
          }
        }
      }
    }

    OutputPane(output, wrap_output, Window.width - 36, Window.height - 300)
  }
}

view Updates(version, update_status, update_trigger) {
  Stack(orientation: vertical, align: center, justify: center, gap: 18,
    width: Window.width, height: Window.height - 58) {

    Glass(effect: liquid, radius: 20, padding: 28, tint: #16161b, tintOpacity: 0.94,
      width: 440) {
      Stack(orientation: vertical, align: center, gap: 14, width: 384) {
        Image("icon.png", width: 120, height: 120, fillMode: fit,
          antialiasing: true)
        Text("Astra", size: 26, color: #f4f4f5, weight: bold)
        Text("Mikasa interpreter", size: 13, color: #8d8d95)

        Rectangle(width: 384, height: 1, background: #26262e) {}

        Text("installed  $version", size: 13, color: #c4c4cc)

        Stack(orientation: horizontal, align: center, justify: center, gap: 8,
          width: 210, height: 40, background: #e23b3b, radius: 10, cursor: pointer,
          onClick: {
            update_status = "Checking for updates…"
            update_trigger = update_trigger + 1
          }) {
          Image("update.png", width: 16, height: 16, fillMode: fit)
          Text("Check for updates", size: 14, color: #ffffff, weight: bold)
        }

        if update_status == "" {
          Text("Astra checks GitHub for a newer nightly.", size: 12, color: #5c5c66,
            align: center, width: 384)
        } else {
          Text(update_status, size: 13, color: #d6d6dc, align: center, width: 384,
            wrap: true)
        }
      }
    }
  }
}
