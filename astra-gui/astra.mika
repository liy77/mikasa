// Astra — GUI in Mikasa (MocidaUI). Visual language: Apple HIG (macOS dark).
// Logic: backend.mika. Host hot-reloads this file in dev.

App() {
  name: "Astra"
  width: 1180
  height: 760
  minWidth: 880
  minHeight: 580
  background: #1C1C1E
  mainContent: AstraApp
  host: "."
}

view AstraApp() {
  mut nav = signal(0)
  mut mode = signal(0)
  mut source = signal("")
  mut output = signal("")
  mut run_trigger = signal(0)
  mut open_trigger = signal(0)
  mut path_field = signal("")
  mut update_trigger = signal(0)
  mut update_status = signal("")
  mut version = signal("…")
  mut wrap_output = signal(true)
  mut status = signal("")

  Stack(
    orientation: horizontal,
    align: stretch,
    background: #1C1C1E,
    width: Window.width,
    height: Window.height
  ) {
    // ── Sidebar (HIG: secondary grouped) ─────────────────────────────────
    Rectangle(
      width: 220,
      height: Window.height,
      background: #2C2C2E
    ) {
      Stack(
        orientation: vertical,
        align: stretch,
        justify: spaceBetween,
        width: 220,
        height: Window.height,
        paddingTop: 18,
        paddingBottom: 16,
        paddingLeft: 12,
        paddingRight: 12
      ) {
        Stack(orientation: vertical, align: stretch, gap: 20, width: 196) {
          Stack(orientation: horizontal, align: center, gap: 10, width: 196) {
            Image(
              "mocida://icon",
              width: 36,
              height: 36,
              fillMode: fit,
              antialiasing: true,
              radius: 8
            )
            Stack(orientation: vertical, gap: 1, align: left) {
              Text("Astra", size: 15, color: #F5F5F7, weight: bold, fontFamily: "SF Pro Text")
              Text("Mikasa VM", size: 11, color: #98989D, fontFamily: "SF Pro Text")
            }
          }

          Stack(orientation: vertical, align: stretch, gap: 2, width: 196) {
            SideNav("Playground", nav == 0, 0, nav, "chevron.left.forwardslash.chevron.right", "mocida://icons/code.png")
            SideNav("Runner", nav == 1, 1, nav, "terminal", "mocida://icons/terminal.png")
            SideNav("Updates", nav == 2, 2, nav, "arrow.triangle.2.circlepath", "mocida://icons/update.png")
          }
        }

        Stack(orientation: vertical, align: stretch, gap: 6, width: 196) {
          Rectangle(width: 196, height: 1, background: #38383A) {}
          Text(format("v{}", version), size: 11, color: #98989D, fontFamily: "SF Pro Text")
          Text("F1 · F2 · F3", size: 10, color: #636366, fontFamily: "SF Pro Text")
        }
      }
    }

    if nav == 0 {
      Playground(mode, source, output, run_trigger, wrap_output, status)
    } else if nav == 1 {
      Runner(path_field, output, run_trigger, open_trigger, wrap_output, status)
    } else {
      Updates(version, update_status, update_trigger)
    }
  }
}

view SideNav(label, on, index, target, icon, fallback) {
  if on {
    Stack(
      orientation: horizontal,
      align: center,
      gap: 10,
      height: 34,
      width: 196,
      background: #0A84FF,
      radius: 8,
      paddingLeft: 10,
      paddingRight: 10,
      cursor: pointer,
      onClick: { target = index }
    ) {
      Icon(icon, fallback: fallback, size: 18, tint: #FFFFFF)
      Text(label, size: 13, color: #FFFFFF, weight: bold, fontFamily: "SF Pro Text")
    }
  } else {
    Stack(
      orientation: horizontal,
      align: center,
      gap: 10,
      height: 34,
      width: 196,
      background: #2C2C2E,
      radius: 8,
      paddingLeft: 10,
      paddingRight: 10,
      cursor: pointer,
      onClick: { target = index }
    ) {
      Icon(icon, fallback: fallback, size: 18, tint: #98989D)
      Text(label, size: 13, color: #F5F5F7, fontFamily: "SF Pro Text")
    }
  }
}

view ModeChip(label, on, index, target, icon, fallback) {
  if on {
    Stack(
      orientation: horizontal,
      align: center,
      gap: 6,
      height: 26,
      background: #48484A,
      radius: 6,
      paddingLeft: 10,
      paddingRight: 10,
      cursor: pointer,
      onClick: { target = index }
    ) {
      Icon(icon, fallback: fallback, size: 12, tint: #FFFFFF)
      Text(label, size: 12, color: #FFFFFF, weight: bold, fontFamily: "SF Pro Text")
    }
  } else {
    Stack(
      orientation: horizontal,
      align: center,
      gap: 6,
      height: 26,
      background: #2C2C2E,
      radius: 6,
      paddingLeft: 10,
      paddingRight: 10,
      cursor: pointer,
      onClick: { target = index }
    ) {
      Icon(icon, fallback: fallback, size: 12, tint: #98989D)
      Text(label, size: 12, color: #98989D, fontFamily: "SF Pro Text")
    }
  }
}

view Playground(mode, source, output, run_trigger, wrap_output, status) {
  Stack(
    orientation: vertical,
    align: stretch,
    gap: 12,
    padding: 20,
    width: Window.width - 220,
    height: Window.height,
    background: #1C1C1E
  ) {
    Stack(
      orientation: horizontal,
      align: center,
      justify: spaceBetween,
      width: Window.width - 260,
      height: 36
    ) {
      Stack(orientation: horizontal, align: center, gap: 8) {
        Text("Playground", size: 20, color: #F5F5F7, weight: bold, fontFamily: "SF Pro Display")
        if status != "" {
          Text(status, size: 12, color: #98989D, fontFamily: "SF Pro Text")
        }
      }
      Stack(orientation: horizontal, align: center, gap: 10) {
        Rectangle(
          height: 28,
          background: #2C2C2E,
          radius: 8,
          paddingLeft: 3,
          paddingRight: 3
        ) {
          Stack(orientation: horizontal, align: center, gap: 2, height: 28) {
            ModeChip("Split", mode == 0, 0, mode, "rectangle.split.2x1", "mocida://icons/split.png")
            ModeChip("Editor", mode == 1, 1, mode, "chevron.left.forwardslash.chevron.right", "mocida://icons/code.png")
            ModeChip("Output", mode == 2, 2, mode, "terminal", "mocida://icons/terminal.png")
          }
        }
        Stack(
          orientation: horizontal,
          align: center,
          gap: 6,
          height: 32,
          background: #0A84FF,
          radius: 8,
          paddingLeft: 12,
          paddingRight: 14,
          cursor: pointer,
          onClick: { status = "Running…" ; run_trigger = run_trigger + 1 }
        ) {
          Icon("play.fill", fallback: "mocida://icons/play.png", size: 13, tint: #FFFFFF)
          Text("Run", size: 13, color: #FFFFFF, weight: bold, fontFamily: "SF Pro Text")
        }
      }
    }

    if mode == 1 {
      EditorPane(source, Window.width - 260, Window.height - 80)
    } else if mode == 2 {
      OutputPane(output, wrap_output, Window.width - 260, Window.height - 80)
    } else if Window.width == 0 or Window.width >= 1040 {
      Stack(
        orientation: horizontal,
        align: stretch,
        gap: 12,
        width: Window.width - 260,
        height: Window.height - 80
      ) {
        EditorPane(source, (Window.width - 284) / 2, Window.height - 80)
        OutputPane(output, wrap_output, (Window.width - 284) / 2, Window.height - 80)
      }
    } else {
      Stack(orientation: vertical, align: stretch, gap: 12, width: Window.width - 260) {
        EditorPane(source, Window.width - 260, (Window.height - 104) / 2)
        OutputPane(output, wrap_output, Window.width - 260, (Window.height - 104) / 2)
      }
    }
  }
}

view EditorPane(source, w, h) {
  Stack(orientation: vertical, align: stretch, gap: 8, width: w, height: h) {
    Text("Source", size: 11, color: #98989D, weight: bold, fontFamily: "SF Pro Text")
    TextArea(
      value: source,
      placeholder: "func main() {\n    println(\"hello from Astra\")\n}",
      width: w,
      height: h - 24,
      background: #2C2C2E,
      textColor: #F5F5F7,
      borderColor: #38383A,
      borderWidth: 1,
      radius: 10,
      padding: 14,
      fontSize: 13,
      fontFamily: "SF Mono",
      cursor: text,
      onChange: { |v| source = v },
    )
  }
}

view OutputPane(output, wrap_output, w, h) {
  Stack(orientation: vertical, align: stretch, gap: 8, width: w, height: h) {
    Stack(orientation: horizontal, align: center, justify: spaceBetween, width: w, height: 22) {
      Text("Output", size: 11, color: #98989D, weight: bold, fontFamily: "SF Pro Text")
      Switch(
        "Wrap",
        value: wrap_output,
        onColor: #0A84FF,
        offColor: #48484A,
        knobColor: #FFFFFF,
        labelColor: #98989D,
        labelSize: 11,
        onChange: { |v| wrap_output = v }
      )
    }
    Rectangle(
      width: w,
      height: h - 30,
      background: #2C2C2E,
      radius: 10,
      borderColor: #38383A,
      borderWidth: 1
    ) {
      Text(
        output,
        size: 12,
        color: #E5E5EA,
        align: left,
        vAlign: top,
        padding: 14,
        wrap: wrap_output,
        fontFamily: "SF Mono"
      )
    }
  }
}

view Runner(path_field, output, run_trigger, open_trigger, wrap_output, status) {
  Stack(
    orientation: vertical,
    align: stretch,
    gap: 16,
    padding: 20,
    width: Window.width - 220,
    height: Window.height,
    background: #1C1C1E
  ) {
    Text("Runner", size: 20, color: #F5F5F7, weight: bold, fontFamily: "SF Pro Display")

    Rectangle(
      width: Window.width - 260,
      background: #2C2C2E,
      radius: 12,
      borderColor: #38383A,
      borderWidth: 1,
      padding: 16
    ) {
      Stack(orientation: vertical, align: stretch, gap: 12, width: Window.width - 292) {
        Text("Open a file", size: 13, color: #F5F5F7, weight: bold, fontFamily: "SF Pro Text")
        Text(
          "Choose a .mika on disk. Run uses that file instead of the editor buffer.",
          size: 12,
          color: #98989D,
          wrap: true,
          width: Window.width - 292,
          fontFamily: "SF Pro Text"
        )
        Input(
          value: path_field,
          placeholder: "path/to/file.mika",
          width: Window.width - 292,
          height: 36,
          background: #1C1C1E,
          textColor: #F5F5F7,
          placeholderColor: #636366,
          borderColor: #38383A,
          borderColorFocused: #0A84FF,
          borderWidth: 1,
          radius: 8,
          padding: 10,
          fontSize: 13,
          fontFamily: "SF Pro Text",
          cursor: text,
          onChange: { |v| path_field = v },
        )
        Stack(orientation: horizontal, gap: 8, align: center) {
          Stack(
            orientation: horizontal,
            align: center,
            gap: 6,
            height: 32,
            background: #3A3A3C,
            radius: 8,
            paddingLeft: 12,
            paddingRight: 14,
            cursor: pointer,
            onClick: { open_trigger = open_trigger + 1 }
          ) {
            Icon("folder.fill", fallback: "mocida://icons/folder.png", size: 14, tint: #F5F5F7)
            Text("Choose…", size: 13, color: #F5F5F7, fontFamily: "SF Pro Text")
          }
          Stack(
            orientation: horizontal,
            align: center,
            gap: 6,
            height: 32,
            background: #0A84FF,
            radius: 8,
            paddingLeft: 12,
            paddingRight: 14,
            cursor: pointer,
            onClick: { status = "Running…" ; run_trigger = run_trigger + 1 }
          ) {
            Icon("play.fill", fallback: "mocida://icons/play.png", size: 13, tint: #FFFFFF)
            Text("Run file", size: 13, color: #FFFFFF, weight: bold, fontFamily: "SF Pro Text")
          }
        }
      }
    }

    OutputPane(output, wrap_output, Window.width - 260, Window.height - 260)
  }
}

view Updates(version, update_status, update_trigger) {
  Stack(
    orientation: vertical,
    align: center,
    justify: center,
    gap: 16,
    width: Window.width - 220,
    height: Window.height,
    background: #1C1C1E
  ) {
    Rectangle(
      width: 400,
      background: #2C2C2E,
      radius: 14,
      borderColor: #38383A,
      borderWidth: 1,
      padding: 28
    ) {
      Stack(orientation: vertical, align: center, gap: 12, width: 344) {
        Image(
          "mocida://icon",
          width: 72,
          height: 72,
          fillMode: fit,
          antialiasing: true,
          radius: 16
        )
        Text("Astra", size: 22, color: #F5F5F7, weight: bold, fontFamily: "SF Pro Display")
        Text("Mikasa interpreter", size: 13, color: #98989D, fontFamily: "SF Pro Text")

        Rectangle(width: 344, height: 1, background: #38383A) {}

        Text(format("Installed  v{}", version), size: 13, color: #E5E5EA, fontFamily: "SF Pro Text")

        Stack(
          orientation: horizontal,
          align: center,
          justify: center,
          gap: 8,
          width: 220,
          height: 36,
          background: #0A84FF,
          radius: 9,
          cursor: pointer,
          onClick: {
            update_status = "Checking GitHub for a newer build…"
            update_trigger = update_trigger + 1
          }
        ) {
          Icon("arrow.triangle.2.circlepath", fallback: "mocida://icons/update.png", size: 14, tint: #FFFFFF)
          Text("Check for Updates", size: 13, color: #FFFFFF, weight: bold, fontFamily: "SF Pro Text")
        }

        if update_status == "" {
          Text(
            "Astra checks GitHub Releases for a newer nightly.",
            size: 12,
            color: #636366,
            align: center,
            width: 344,
            fontFamily: "SF Pro Text"
          )
        } else {
          Text(
            update_status,
            size: 13,
            color: #E5E5EA,
            align: center,
            width: 344,
            wrap: true,
            fontFamily: "SF Pro Text"
          )
        }
      }
    }
  }
}
