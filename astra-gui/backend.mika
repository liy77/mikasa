// Astra GUI backend, written in Mikasa.
//
// Pure logic: no imports. The host (src/main.rs) transpiles this file and
// calls the functions; it does the IO (reading files, HTTP, running a
// program) and asks this module to decide what the results mean.

// The version this build reports. The host passes the real one in.
func String current_version() {
    return "0.1.0"
}

// True when `latest` (vX.Y.Z) is strictly newer than `current`.
func bool is_newer(latest: &str, current: &str) {
    mut a = version_nums(latest)
    mut b = version_nums(current)
    mut i = 0
    while i < 3 {
        if a[i] != b[i] {
            return a[i] > b[i]
        }
        i = i + 1
    }
    return false
}

// The first three numeric parts of a version tag. "v1.2.3-pre" -> [1, 2, 3].
func Vec<i64> version_nums(v: &str) {
    mut clean = v.trim_start_matches('v')
    mut out = vec![0, 0, 0]
    mut i = 0
    mut part = String::new()
    for ch in clean.chars() {
        if ch.is_ascii_digit() {
            part.push(ch)
        } else {
            if i < 3 && !part.is_empty() {
                out[i] = part.parse::<i64>().unwrap_or(0)
                i = i + 1
            }
            if ch != '.' {
                break
            }
            part = String::new()
        }
    }
    if i < 3 && !part.is_empty() {
        out[i] = part.parse::<i64>().unwrap_or(0)
    }
    return out
}

// The first `"field": "value"` string in `json`. "" when it is absent.
func String json_string(text: &str, field: &str) {
    mut needle = format!("\"{}\"", field)
    mut at = text.find(&needle)
    if at.is_none() {
        return String::new()
    }
    mut rest = &text[at.unwrap() + needle.len()..]
    mut colon = rest.find(':')
    if colon.is_none() {
        return String::new()
    }
    mut after = rest[colon.unwrap() + 1..].trim_start()
    if !after.starts_with('"') {
        return String::new()
    }
    mut body = &after[1..]
    mut end = body.find('"')
    if end.is_none() {
        return String::new()
    }
    return body[..end.unwrap()].to_string()
}

// The download URL for this operating system, from a GitHub release body.
// `os_key` is "windows", "apple" or "linux".
func String pick_asset(text: &str, os_key: &str) {
    mut needle = "\"browser_download_url\""
    mut from = 0
    while from < text.len() {
        mut slice = &text[from..]
        mut rel = slice.find(needle)
        if rel.is_none() {
            break
        }
        mut url = json_string(&text[from + rel.unwrap()..], "browser_download_url")
        if url.contains(os_key) {
            return url
        }
        if os_key == "apple" && url.contains("darwin") {
            return url
        }
        from = from + rel.unwrap() + needle.len()
    }
    return String::new()
}

// "current|latest|yes|asset" or "current|latest|no|asset". The host fetches
// the release JSON and passes it here; this decides whether to update.
func String describe_update(release_json: &str, current: &str, os_key: &str) {
    mut latest = json_string(release_json, "tag_name")
    mut asset = pick_asset(release_json, os_key)
    mut available = "no"
    if is_newer(&latest, current) {
        available = "yes"
    }
    return format!("{}|{}|{}|{}", current, latest, available, asset)
}
